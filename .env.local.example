# IBMiHub AI -- Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to the repository.

# Supabase -- from: Supabase project -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Service role key -- server-side ONLY; bypasses RLS; NEVER expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Full URL of this deployment (used in auth callback redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI Provider -- required for the AI Tutor (Batch 19).
# Get a key from the Anthropic Console: https://console.anthropic.com/
# Server-side only -- never prefix this with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=

# Google Analytics 4 Measurement ID -- optional. Only set in Vercel's
# Production environment; leave unset locally and in Preview deploys so
# analytics never fires from a dev/test session. components/analytics/
# google-analytics.tsx renders nothing at all when this is empty.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Cloudflare Turnstile -- CAPTCHA on the sign-up, login and password-reset
# forms (PR #183). Create a widget at:
#   Cloudflare dashboard -> Turnstile -> Add widget
#
# Master switch. Server-side only -- never prefix this with NEXT_PUBLIC_, or
# the browser could edit it. Only the exact string 'true' enables CAPTCHA;
# absent, empty, or anything else leaves authentication behaving exactly as
# it did before PR #183 (no widget, no token, no gate).
#
# Leave this false until BOTH the site key below and the secret in Supabase
# are in place. Turning it on without a site key deliberately fails closed
# and will block sign-in.
TURNSTILE_ENFORCEMENT_ENABLED=false

# ONLY the site key belongs here. It is public by design and is rendered into
# the browser. Setting it alone changes nothing until the flag above is true.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# The matching Turnstile SECRET key is NOT an environment variable of this
# app and must never be added to this file, to Vercel, or to any NEXT_PUBLIC_
# variable. Supabase performs the Cloudflare siteverify call itself, so the
# secret is pasted only into:
#   Supabase dashboard -> Authentication -> Attack Protection -> CAPTCHA
#
# Cloudflare's always-passing test keys (useful locally, no real challenge):
#   site key 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
